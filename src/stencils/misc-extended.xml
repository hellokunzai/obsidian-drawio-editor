<?xml version="1.0" encoding="UTF-8"?>
<shapes name="misc-extended">
  <!-- Gear/Settings -->
  <shape name="gear" aspect="1" strokewidth="inherit">
    <background>
      <ellipse x="25" y="25" w="50" h="50"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <path>
        <move x="50" y="0"/>
        <line x="55" y="15"/>
        <line x="65" y="5"/>
        <line x="65" y="20"/>
        <line x="80" y="15"/>
        <line x="75" y="25"/>
        <line x="95" y="25"/>
        <line x="85" y="35"/>
        <line x="95" y="45"/>
        <line x="80" y="50"/>
        <line x="85" y="60"/>
        <line x="75" y="65"/>
        <line x="80" y="75"/>
        <line x="65" y="70"/>
        <line x="65" y="85"/>
        <line x="55" y="75"/>
        <line x="50" y="100"/>
        <line x="45" y="75"/>
        <line x="35" y="85"/>
        <line x="35" y="70"/>
        <line x="20" y="75"/>
        <line x="25" y="65"/>
        <line x="5" y="60"/>
        <line x="15" y="50"/>
        <line x="5" y="45"/>
        <line x="20" y="40"/>
        <line x="15" y="25"/>
        <line x="25" y="20"/>
        <line x="20" y="10"/>
        <line x="35" y="15"/>
        <line x="35" y="5"/>
        <line x="45" y="15"/>
        <close/>
      </path>
      <stroke/>
      <ellipse x="38" y="38" w="24" h="24"/>
      <stroke/>
    </foreground>
  </shape>

  <!-- Lightning bolt -->
  <shape name="lightning" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="55" y="0"/>
        <line x="20" y="50"/>
        <line x="45" y="50"/>
        <line x="25" y="100"/>
        <line x="80" y="35"/>
        <line x="55" y="35"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Checkmark -->
  <shape name="checkmark" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="0" y="50"/>
        <line x="30" y="80"/>
        <line x="100" y="10"/>
      </path>
    </background>
    <foreground>
      <stroke/>
    </foreground>
  </shape>

  <!-- Cross/X -->
  <shape name="cross" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="0" y="0"/>
        <line x="100" y="100"/>
        <move x="100" y="0"/>
        <line x="0" y="100"/>
      </path>
    </background>
    <foreground>
      <stroke/>
    </foreground>
  </shape>

  <!-- Speech bubble -->
  <shape name="speechBubble" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="0" y="0"/>
        <line x="100" y="0"/>
        <line x="100" y="50"/>
        <line x="30" y="50"/>
        <line x="20" y="70"/>
        <line x="15" y="50"/>
        <line x="0" y="50"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Key -->
  <shape name="key" aspect="1" strokewidth="inherit">
    <background>
      <ellipse x="0" y="30" w="30" h="30"/>
    </background>
    <foreground>
      <fillstroke/>
      <path>
        <move x="30" y="45"/>
        <line x="100" y="45"/>
        <line x="100" y="35"/>
        <move x="75" y="45"/>
        <line x="75" y="55"/>
        <move x="90" y="45"/>
        <line x="90" y="55"/>
      </path>
      <stroke/>
    </foreground>
  </shape>

  <!-- Lock -->
  <shape name="lock" aspect="1" strokewidth="inherit">
    <background>
      <roundrect x="10" y="30" w="80" h="50" arcsize="10"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <path>
        <move x="25" y="30"/>
        <line x="25" y="15"/>
        <quad x="50" y="-5" x="75" y="15"/>
        <line x="75" y="30"/>
      </path>
      <stroke/>
      <circle x="45" y="45" r="5"/>
      <stroke/>
    </foreground>
  </shape>

  <!-- Unlock -->
  <shape name="unlock" aspect="1" strokewidth="inherit">
    <background>
      <roundrect x="10" y="30" w="80" h="50" arcsize="10"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <path>
        <move x="25" y="30"/>
        <line x="25" y="15"/>
        <quad x="50" y="-5" x="75" y="15"/>
        <line x="75" y="25"/>
      </path>
      <stroke/>
      <circle x="45" y="45" r="5"/>
      <stroke/>
    </foreground>
  </shape>

  <!-- Clock -->
  <shape name="clock" aspect="1" strokewidth="inherit">
    <background>
      <ellipse x="0" y="0" w="100" h="100"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <line x="50" y="50"/>
      <line x="50" y="20"/>
      <move x="50" y="50"/>
      <line x="75" y="50"/>
      <stroke/>
    </foreground>
  </shape>

  <!-- Calendar -->
  <shape name="calendar" aspect="1" strokewidth="inherit">
    <background>
      <rect x="0" y="10" w="100" h="70"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <rect x="0" y="10" w="100" h="15"/>
      <fillstroke/>
      <path>
        <move x="20" y="0"/>
        <line x="20" y="20"/>
        <move x="80" y="0"/>
        <line x="80" y="20"/>
        <move x="0" y="40"/>
        <line x="100" y="40"/>
        <move x="0" y="55"/>
        <line x="100" y="55"/>
        <move x="0" y="70"/>
        <line x="100" y="70"/>
      </path>
      <stroke/>
    </foreground>
  </shape>

  <!-- Email/Envelope -->
  <shape name="envelope" aspect="1" strokewidth="inherit">
    <background>
      <rect x="0" y="0" w="100" h="60"/>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <path>
        <move x="0" y="0"/>
        <line x="50" y="35"/>
        <line x="100" y="0"/>
      </path>
      <stroke/>
    </foreground>
  </shape>

  <!-- Folder -->
  <shape name="folder" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="0" y="15"/>
        <line x="30" y="15"/>
        <line x="40" y="0"/>
        <line x="100" y="0"/>
        <line x="100" y="60"/>
        <line x="0" y="60"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Open folder -->
  <shape name="folderOpen" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="0" y="15"/>
        <line x="30" y="15"/>
        <line x="40" y="0"/>
        <line x="100" y="0"/>
        <line x="100" y="20"/>
        <line x="90" y="60"/>
        <line x="0" y="60"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
      <strokewidth width="1"/>
      <path>
        <move x="0" y="15"/>
        <line x="90" y="15"/>
        <line x="90" y="60"/>
      </path>
      <stroke/>
    </foreground>
  </shape>

  <!-- Flag -->
  <shape name="flag" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="10" y="0"/>
        <line x="10" y="100"/>
        <move x="10" y="0"/>
        <line x="90" y="0"/>
        <line x="90" y="40"/>
        <line x="10" y="40"/>
      </path>
    </background>
    <foreground>
      <stroke/>
      <path>
        <move x="10" y="0"/>
        <line x="90" y="0"/>
        <line x="90" y="40"/>
        <line x="10" y="40"/>
        <close/>
      </path>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Star -->
  <shape name="star" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="50" y="0"/>
        <line x="61" y="35"/>
        <line x="100" y="35"/>
        <line x="68" y="57"/>
        <line x="79" y="95"/>
        <line x="50" y="72"/>
        <line x="21" y="95"/>
        <line x="32" y="57"/>
        <line x="0" y="35"/>
        <line x="39" y="35"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>

  <!-- Heart -->
  <shape name="heart" aspect="1" strokewidth="inherit">
    <background>
      <path>
        <move x="50" y="90"/>
        <quad x="0" y="50" x="20" y="20"/>
        <quad x="40" y="0" x="50" y="30"/>
        <quad x="60" y="0" x="80" y="20"/>
        <quad x="100" y="50" x="50" y="90"/>
        <close/>
      </path>
    </background>
    <foreground>
      <fillstroke/>
    </foreground>
  </shape>
</shapes>
